          "SuperAdministrador",
          "adminElecciones",
          "juradoElecciones",
          "adminPadron"
        ],
        "type": "string"
      },
      "Usuario": {
        "required": [
          "email",
          "nombre",
          "rol"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "rol": {
